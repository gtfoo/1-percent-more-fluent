# Text generation. Free tier is plenty for one reader: a 400-word story is
# roughly 600 output tokens - but it caps at 20 requests a day, which a single
# session of tuning will exhaust. The other two keys are the way past that.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Without them the chain silently drops to whatever has a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Ordered fallback chain, tried left to right when one hits its quota.
# Each entry may name its own provider; a bare id uses LLM_PROVIDER (default
# google). Crossing providers is the point - a quota is per-lab, so a chain of
# three Gemini models all die together the moment the daily limit lands.
#
# Defaults to:
#   google:gemini-3.5-flash,google:gemini-flash-latest,
#   anthropic:claude-haiku-4-5,anthropic:claude-sonnet-5
#
# No OpenAI entry by default: unlike the Anthropic ids, that one was not checked
# against a live account, and a wrong id is a 404 mid-generation. Run
# `npm run models` to list what your key actually grants, then add it here.
# LLM_MODELS=google:gemini-3.5-flash,anthropic:claude-haiku-4-5,openai:<id>
# LLM_PROVIDER=google

# Optional. Your own `fluent_uid` cookie value - read it from the browser's dev
# tools on the deployed site. Only that visitor sees the running speech bill,
# which is operator information and means nothing to a learner. Unset: nobody.
# ADMIN_USER_ID=

# Speech. This is the expensive half - see src/server/tts.ts. Everything is
# cached by content hash, so you only ever pay once per piece of text.
ELEVENLABS_API_KEY=

# Optional overrides. eleven_multilingual_v2 costs $0.10/1k characters;
# eleven_flash_v2_5 is half that and arguably clearer for a learner.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_MAX_CHARS=6000

# Signing in. ENTIRELY OPTIONAL, and leaving all of this blank is a supported
# state - the app then behaves exactly as it always has, no sign-in is offered,
# and /api/auth/* answers 404 rather than mounting and failing. An account
# exists only so a level built over weeks follows you to another device.
#
# The first two are required TOGETHER: a provider without a secret is not
# usable, so it is not offered.
#
# QUOTE the secret. Generate it with `openssl rand -base64 32`, which can emit
# a `#` - and dotenv treats that as the start of a comment, silently discarding
# everything after it. The symptom is a sign-in page insisting nothing is
# configured while the line sits plainly in the file.
# AUTH_SECRET="..."
#
# Resend. Free tier is 3,000/month and 100/day, which one reader will not touch.
# AUTH_RESEND_KEY=re_...
#
# Must be on a domain VERIFIED in Resend, and A SUBDOMAIN IS A SEPARATE DOMAIN
# there: sending from login@1-percent-more-fluent.gtfoo.com while only
# gtfoo.com is verified fails, and the only symptom is that no mail arrives.
# Defaults to login@gtfoo.com.
# AUTH_EMAIL_FROM=login@gtfoo.com
#
# The site's own origin, used to build the link inside the email. Needed in
# production; locally this is http://localhost:3003.
# AUTH_URL=https://1-percent-more-fluent.gtfoo.com
