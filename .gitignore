# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local learner data: the SQLite file and the synthesised audio cache, which
# lives at data/audio. The audio is a cache - deleting it is safe but costs real
# money to rebuild, so keep backups. Kept out of public/ deliberately: a
# standalone build replaces that directory, which would orphan the cache.
/data

# generated by `npm run wordlist`, ~1MB, rebuildable for free from public lists.
# Note this is deliberately narrower than /src/data: samples.json is generated
# by an LLM and costs money to rebuild, so it is committed.
/src/data/*/frequency.json
/src/data/*/placement.json
/src/data/*/anchors.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Stray curl cookie jars: a mistyped "curl -b " writes a file literally
# named -b, and git add -A has swept one into a commit before.
-b
